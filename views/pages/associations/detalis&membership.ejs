<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= selectedAssociation ? selectedAssociation.name : 'Association Details' %> — SportConnect Pro</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <!-- Crucial: theme.css MUST load before style.css -->
    <link rel="stylesheet" href="/public/css/theme.css">
    <link rel="stylesheet" href="/public/css/style.css">
</head>

<body>

    <!-- Top Navigation Bar -->
    <nav class="topbar">
        <div class="wrap">
            <div class="brand">
                Sport<span>Connect</span> Pro
            </div>
            <div class="navlinks">
                <a href="/">Home</a>
                <a href="/facilities">Facilities</a>
                <a href="/activities">Activities</a>
                <a href="/members">Members</a>
                <a href="/registrations">Registrations</a>
            </div>
        </div>
    </nav>

    <!-- Main Association Details Content -->
    <main class="association-detail-page">
        <div class="wrap">

            <% if (typeof selectedAssociation !== 'undefined' && selectedAssociation) { %>
                
                <!-- Back Link -->
                <div class="back-nav">
                    <a href="/" class="back-link">← Back to Overview</a>
                </div>

                <div class="details-container">
                    
                    <!-- Header Info Card -->
                    <div class="details-header-card">
                        <div class="badge-tag">Partner Association</div>
                        <h1><%= selectedAssociation.name %></h1>
                        <p class="association-desc"><%= selectedAssociation.description || 'No description provided for this association.' %></p>
                    </div>

                    <!-- Information Grid -->
                    <div class="info-grid">
                        <div class="info-item">
                            <span class="info-label">Contact Email</span>
                            <span class="info-value"><%= selectedAssociation.contact_email %></span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Phone Number</span>
                            <span class="info-value"><%= selectedAssociation.phone %></span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">SIREN Number</span>
                            <span class="info-value tabular-num"><%= selectedAssociation.siren_number %></span>
                        </div>

                        <div class="info-item">
                            <span class="info-label">Member Since</span>
                            <span class="info-value tabular-num">
                                <%= new Date(selectedAssociation.created_at).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                            </span>
                        </div>
                    </div>

                    <!-- Action Banner / Button -->
                    <div class="membership-action-box">
                        <div class="action-text">
                            <h3>Ready to join this association?</h3>
                            <p>Register your membership to gain access to their schedule, facilities, and sports activities.</p>
                        </div>
                        <!-- Become a member button route -->
                        <form action="/inscription/<%= selectedAssociation.id %>" method="GET">
                            <button  type="submit" class="btn btn-primary btn-lg">
                                Become a member →
                            </button>
                        </form>
                    </div>

                </div>

            <% } else { %>
                <div class="empty-state-container">
                    <h2>Association Not Found</h2>
                    <p class="empty-note">The association you are looking for does not exist or has been removed.</p>
                    <a href="/" class="btn btn-secondary">Return Home</a>
                </div>
            <% } %>

        </div>
    </main>

    <!-- Footer -->
    <footer>
        <div class="wrap">
            <span>SportConnect Pro — Direction des Sports et de la Vie Associative</span>
            <span>Built on Node.js, PostgreSQL, and HTML</span>
        </div>
    </footer>

</body>
</html>