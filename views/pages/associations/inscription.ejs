<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Member Registration — SportConnect Pro</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/public/css/theme.css">
    <link rel="stylesheet" href="/public/css/style.css">
</head>

<body>

    <main class="form-page">
        <div class="wrap">

            <div class="back-nav">
                <a href="javascript:history.back()" class="back-link">← Back to Overview</a>
            </div>

            <div class="form-card-container">
                <div class="form-header">
                    <span class="badge-tag">Adhesion Portal</span>
                    <h1>New Member Registration</h1>
                    <p>Register a new member to link them with municipal activities, calculate household tier discounts, and verify medical compliance.</p>
                </div>

                <form action="/members" method="POST" class="styled-form" id="worker_form">

    <% if (typeof associationId !== 'undefined' && associationId) { %>
        <input type="hidden" name="association_id" value="<%= associationId %>">
    <% } %>

    <fieldset class="form-section">
        <h2>Personal Information</h2>
        
        <div class="form-row grid-2">
            <div class="form-group">
                <label for="first_name">First Name </label>
                <input type="text" id="first_name" name="first_name" class="userInputs"  placeholder="e.g. Jean">
                <span class="error-message hidden"></span>
            </div>
            <div class="form-group">
                <label for="last_name">Last Name </label>
                <input type="text" id="last_name" name="last_name" class="userInputs"  placeholder="e.g. Dupont">
                <span class="error-message hidden"></span>
            </div>
        </div>

        <div class="form-row grid-2">
            <div class="form-group">
                <label for="email">Email Address </label>
                <input type="email" id="email" name="email" class="userInputs"  placeholder="jean.dupont@example.fr">
                <span class="error-message hidden"></span>
            </div>
            <div class="form-group">
                <label for="phone">Phone Number </label>
                <input type="tel" id="phone" name="phone" class="userInputs"  placeholder="+33 6 00 00 00 00">
                <span class="error-message hidden"></span>
            </div>
        </div>

        <div class="form-row grid-2">
            <div class="form-group">
                <label for="date_of_birth">Date of Birth </label>
                <input type="date" id="date_of_birth" name="date_of_birth" class="userInputs" >
                <span class="error-message hidden"></span>
                <small class="help-text">Used for federal age category calculation (U9, U13, Senior, etc.)</small>
            </div>
            <div class="form-group">
                <label for="family_id">Household / Family ID (Optional)</label>
                <input type="number" id="family_id" name="family_id" class="userInputs" placeholder="Leave blank if primary member">
                <span class="error-message hidden"></span>
                <small class="help-text">Required for multi-member household discounts (-15% / -30%).</small>
            </div>
        </div>
    </fieldset>

    <fieldset class="form-section">
        <h2>Residency & Financial Support</h2>

        <div class="form-row grid-2">
            <div class="form-group checkbox-group">
                <label class="checkbox-label">
                    <input type="checkbox" id="is_resident" name="is_resident" class="userInputs" value="true">
                    <span>Communal Resident</span>
                </label>
                <span class="error-message hidden"></span>
                <small class="help-text">Residents benefit from subsidized base pricing (non-residents incur a +35% municipal fee).</small>
            </div>

            <div class="form-group hidden" id="qfInput" style="display: none;">
                <label for="quotient_familial">Quotient Familial (QF in €)</label>
                <input type="number" id="quotient_familial" name="quotient_familial" class="userInputs" step="0.01" placeholder="e.g. 550.00">
                <span class="error-message hidden"></span>
                <small class="help-text">Used for municipal social reductions (-40% if QF &lt; 600€, -20% if &le; 900€).</small>
            </div>
        </div>
    </fieldset>

    <fieldset class="form-section">
        <h2>Medical Compliance</h2>

        <div class="form-row grid-2">
            <div class="form-group">
                <label for="medical_certificate_date">Medical Certificate Date </label>
                <input type="date" id="medical_certificate_date" name="medical_certificate_date" class="userInputs" (req, res, params(req, res, params>
                <span class="error-message hidden"></span>
                <small class="help-text">Standard sports certificates are valid for 3 years; high-risk sports require &lt; 1 year.</small>
            </div>

            <div class="form-group">
                <label for="pass_sport_code">State Grant Code (Pass'Sport)</label>
                <input type="text" id="pass_sport_code" name="pass_sport_code" class="userInputs" placeholder="Optional voucher code">
                <span class="error-message hidden"></span>
                <small class="help-text">Deducts 50.00 € subject to absolute floor limits.</small>
            </div>
        </div>
    </fieldset>

    <div class="form-actions">
        <a href="/" class="btn btn-secondary">Cancel</a>
        <button type="submit" class="btn btn-primary">Complete Registration →</button>
    </div>

</form>

            </div>

        </div>
    </main>

    <footer>
        <div class="wrap">
            <span>SportConnect Pro — Direction des Sports et de la Vie Associative</span>
            <span>Built on Node.js, PostgreSQL, and HTML</span>
        </div>
    </footer>
<script src="/public/js/client-validation.js"></script>
</body>
</html>