<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SportConnect Pro — All Facilities</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/theme.css">
</head>

<body>

    <%- include("../partials/navbar") %>

    <section style="padding: 40px 0;">

        <div class="wrap">

            <div class="back-nav" style="margin-bottom: 20px;">
                <a href="javascript:history.back()" class="back-link">
                    ← Back to Overview
                </a>
            </div>

            <div class="family-action-header">
                <h2>All Sports Facilities</h2>

                <a href="/facilityCreate" class="btn btn-primary btn-lg">
                    + Create Facility
                </a>
            </div>

            <div class="all-facilities-stack">

                <% if (typeof facilities !== 'undefined' && facilities.length > 0) { %>

                    <% facilities.forEach(facility => { %>

                        <div class="full-width-facility-row">

                            <h3>
                                <%= facility.name %>
                            </h3>

                            <% if (facility.description) { %>
                                <p class="facility-description">
                                    <%= facility.description %>
                                </p>
                            <% } %>

                            <div class="facility-details-meta">

                                <span>
                                    <strong>ERP Capacity:</strong>
                                    <%= facility.erp_capacity %>
                                </span>

                                <span>
                                    <strong>Divisible:</strong>
                                    <%= facility.is_divisible ? 'Yes' : 'No' %>
                                </span>

                            <div class="card-actions">
                                <form action="/facilities/<%= facility.id %>/delete" method="POST">
                                    <button type="submit" class="btn btn-danger">Delete</button>
                                </form>
                            </div>

                        </div>

                    <% }) %>

                <% } else { %>

                    <p class="empty-note">
                        No facilities found at this time.
                    </p>

                <% } %>

            </div>

        </div>

    </section>

</body>

</html>
