<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SportConnect Pro — Season Overview</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">

<link rel="stylesheet" href="/public/css/style.css">
</head>

<body>

<nav class="topbar">
    <div class="wrap">

        <div class="brand">
            Sport<span>Connect</span> Pro
        </div>

        <div class="navlinks">
            <a href="/" class="active">Home</a>
            <a href="/facilities">Facilities</a>
            <a href="/activities">Activities</a>
            <a href="/members">Members</a>
            <a href="/registrations">Registrations</a>
        </div>

    </div>
</nav>


<header class="hero">

    <div class="wrap">

        <h1 >
            One system for every gym, pool, and dojo in the city.
        </h1>

        <p class="lede">
            Track occupancy, enforce fire-safety limits, and run registration for
            40
            partner clubs without a single double-booking.
        </p>

        <div class="hero-actions">
            <a href="/activities" class="btn btn-primary">
                View today's schedule
            </a>

            <a href="/registrations/new" class="btn btn-secondary">
                Register a member
            </a>
        </div>

    </div>

</header>


<div class="scoreboard">

    <div class="wrap">

        <div class="score-item">
            <div class="num">
                12
            </div>

            <div class="label">
                Municipal facilities
            </div>
        </div>


        <div class="score-item">
            <div class="num">
                40
            </div>

            <div class="label">
                Partner associations
            </div>
        </div>


        <div class="score-item">
            <div class="num">
                6,000+
            </div>

            <div class="label">
                Registered members
            </div>
        </div>


        <div class="score-item">
            <div class="num">
                —
            </div>

            <div class="label">
                Activities running this season
            </div>
        </div>

    </div>

</div>


<section>

    <div class="wrap">

        <div class="section-head">
            <h2>Quick actions</h2>
        </div>

        <div class="actions-grid">

            <div class="action-card">
                <h3>Open a new activity</h3>

                <p>
                    Set a schedule, a facility, and a capacity.
                    Conflicts and ERP limits are checked automatically.
                </p>

                <a href="/activities/new" class="go">
                    Create activity →
                </a>
            </div>


            <div class="action-card">
                <h3>Enroll a member</h3>

                <p>
                    Pricing, family discounts, and Pass'Sport are applied
                    as you go — no manual math.
                </p>

                <a href="/registrations/new" class="go">
                    Start enrollment →
                </a>
            </div>


            <div class="action-card">
                <h3>Review the waiting list</h3>

                <p>
                    See who's next in line and confirm promotions
                    before the 48-hour window closes.
                </p>

                <a href="/waiting-list" class="go">
                    Open waiting list →
                </a>
            </div>

        </div>

    </div>

</section>


<section>

    <div class="wrap">

        <div class="section-head">

            <h2>Facility occupancy</h2>

            <a href="/facilities" class="view-all">
                View all facilities
            </a>

        </div>

        <div>

            <div class="facility-row">

                <div>
                    <div class="fname">
                        Central Sports Complex
                    </div>

                    <div class="fmeta">
                        75 / 100 under ERP capacity
                    </div>
                </div>


                <div class="capacity-label">
                    75%
                </div>


                <div class="bar-track">

                    <div
                        class="bar-fill"
                        style="width: 75%;">
                    </div>

                </div>


                <div class="status-pill open">
                    Open
                </div>

            </div>

            <div class="facility-row">

                <div>
                    <div class="fname">
                        Olympic Aquatic Center
                    </div>

                    <div class="fmeta">
                        150 / 150 under ERP capacity
                    </div>
                </div>


                <div class="capacity-label">
                    100%
                </div>


                <div class="bar-track">

                    <div
                        class="bar-fill full"
                        style="width: 100%;">
                    </div>

                </div>


                <div class="status-pill full">
                    At capacity
                </div>

            </div>

        </div>

    </div>

</section>


<section>

    <div class="wrap">

        <div class="section-head">

            <h2>Needs your attention</h2>

            <a href="/registrations" class="view-all">
                View all registrations
            </a>

        </div>

        <div class="alert-list">

            <div class="alert-item">

                <div class="alert-dot info">
                </div>

                <div class="msg">
                    3 medical certificates pending verification
                </div>

                <div class="when">
                    2 hours ago
                </div>

            </div>

        </div>

    </div>

</section>


<footer>

    <div class="wrap">

        <span>
            SportConnect Pro — Direction des Sports et de la Vie Associative
        </span>

        <span>
            Built on Node.js, PostgreSQL, and HTML
        </span>

    </div>

</footer>

</body>
</html>