<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>SportConnect Pro — Season Overview</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link
        href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">

    <link rel="stylesheet" href="/public/css/style.css">
    <link rel="stylesheet" href="/public/css/theme.css">
</head>

<body>

    <nav class="topbar">
        <div class="wrap">

            <div class="brand">
                Sport<span>Connect</span> Pro
            </div>

            <div class="navlinks">
                <a href="/" class="active">Home</a>
                <a href="/facilities">Facilities</a>
                <a href="/activities">Activities</a>
                <a href="/members">Members</a>
                <a href="/registrations">Registrations</a>
            </div>

        </div>
    </nav>

    <!-- Family Creation Callout Banner (Placed before Partner Associations) -->
    <section class="family-cta-section" style="padding-bottom: 0;">
        <div class="wrap">
            <div class="membership-action-box">
                <div>
                    <h3>Household & Family Registration</h3>
                    <p>Register a family group to unlock household tier discounts (-15% for 2 members, -30% for 3+).</p>
                </div>
                <a href="/familyCreate" class="btn btn-primary btn-lg">
                    + Create Family Group
                </a>
            </div>
        </div>
    </section>

    <section>

        <div class="wrap">

            <div class="section-head">
                <h2>Partner Associations</h2>
                <a href="/associations" class="view-all">See all associations</a>
            </div>

            <div class="actions-grid">

                <% if (typeof associations !== 'undefined' && associations.length > 0) { %>
                    <% associations.forEach(assoc => { %>
                        <div class="action-card">
                            <h3>
                                <%= assoc.name %>
                            </h3>
                            <p>
                                <%= assoc.description %>
                            </p>
                            <a href="/associationDetails/<%= assoc.id %>" class="go btn btn-primary">
                                Become a member →
                            </a>

                        </div>
                    <% }) %>
                <% } else { %>
                    <p class="empty-note">No partner associations found at this time.</p>
                <% } %>

            </div>

        </div>

    </section>

    <!-- Scoreboard / Stats Section -->
    <div class="scoreboard">

        <div class="wrap">

            <div class="score-item">
                <div class="num">
                    12
                </div>

                <div class="label">
                    Municipal facilities
                </div>
            </div>

            <div class="score-item">
                <div class="num">
                    40
                </div>

                <div class="label">
                    Partner associations
                </div>
            </div>

            <div class="score-item">
                <div class="num">
                    6,000+
                </div>

                <div class="label">
                    Registered members
                </div>
            </div>

            <div class="score-item">
                <div class="num">
                    —
                </div>

                <div class="label">
                    Activities running this season
                </div>
            </div>

        </div>

    </div>
</body>

</html>